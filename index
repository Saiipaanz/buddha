<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>โครงการ ชุดสาธิตการติดตั้งแอร์</title>
    <!-- โหลด Tailwind CSS ไว้ด้านบนสุด เพื่อให้หน้าเว็บสวยทันทีที่เปิด -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- โหลด React และ Babel -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/babel-standalone@6/babel.min.js"></script>

    <style>
        body { font-family: 'Sarabun', sans-serif; background-color: #F8F9F8; }
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    </style>
    <!-- โหลด Firebase SDK แบบง่ายที่สุด -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
        import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-database.js";

        // ตั้งค่าโปรเจกต์ Firebase (ใช้โปรเจกต์ทดสอบของผมไปก่อนได้เลยครับ)
        const firebaseConfig = {
            databaseURL: "https://budget-app-demo-default-rtdb.asia-southeast1.firebasedatabase.app" 
        };

        const app = initializeApp(firebaseConfig);
        const database = getDatabase(app);
        
        // ทำให้ฟังก์ชัน Firebase ใช้ได้ใน React (ผ่าน Global Object)
        window.firebaseDb = database;
        window.firebaseRef = ref;
        window.firebaseOnValue = onValue;
        window.firebaseSet = set;
    </script>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useMemo, useEffect, useCallback } = React;

        // --- ชุดไอคอน SVG ---
        const Sprout = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M7 20h10"/><path d="M10 20c5.5-1.25 12-4.25 12-12.5a5.5 5.5 0 0 0-5.5-5.5H16"/><path d="M16 2v7"/><path d="M16 5.5c-4 0-9.5 2-9.5 8.5V20"/></svg>;
        const Wallet = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>;
        const ShoppingCart = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>;
        const AlertCircle = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>;
        const LinkIcon = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>;
        const ExternalLink = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>;
        const Minus = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M5 12h14"/></svg>;
        const Plus = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M5 12h14"/><path d="M12 5v14"/></svg>;
        const CheckCircle2 = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>;
        const Trash2 = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>;
        const PlusCircle = ({ className }) => <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>;

        const INITIAL_BUDGET = 120000;

        const INITIAL_ITEMS = [
            { id: 1, name: 'แอร์ 5,000 btu.', qty: 1, price: 0, link: '' },
            { id: 2, name: 'แว๊คคั่ม', qty: 1, price: 0, link: '' },
            { id: 3, name: 'แมนิโฟลเกจ', qty: 2, price: 0, link: '' },
            { id: 4, name: 'ไมครอนเกจ', qty: 1, price: 0, link: '' },
            { id: 5, name: 'เครื่องตรวจรั่ว', qty: 1, price: 0, link: '' },
            { id: 7, name: 'คัตเตอร์ + ชุดบานแฟร์', qty: 1, price: 0, link: '' },
            { id: 8, name: 'สายไฟ + ปลั๊กเสียบ 2.5 mm.', qty: 1, price: 0, link: '' },
            { id: 9, name: 'N2 ถังเล็ก', qty: 1, price: 0, link: '' },
            { id: 10, name: 'ตาชั่ง', qty: 1, price: 0, link: '' },
            { id: 11, name: 'ถัง R290', qty: 1, price: 0, link: '' },
            { id: 12, name: 'เซฟตี้วาล์ว LOW', qty: 2, price: 0, link: '' },
            { id: 13, name: 'ชุดรางครอบท่อ', qty: 2, price: 0, link: '' },
            { id: 14, name: 'ท่อทองแดงสำเร็จ', qty: 2, price: 0, link: '' },
            { id: 15, name: 'ท่อขาว PVC 20 mm. + ข้องอ + ท่ออ่อน', qty: 1, price: 0, link: '' },
            { id: 16, name: 'ท่อน้ำทิ้งเทา + ข้องอ', qty: 1, price: 0, link: '' },
            { id: 17, name: 'ประแจเลื่อนทอร์ค + ประแจเลื่อน', qty: 1, price: 0, link: '' },
            { id: 18, name: 'ชุดเครื่องมือพื้นฐาน', qty: 1, price: 0, link: '' },
            { id: 19, name: 'คลิปแอมป์', qty: 1, price: 0, link: '' },
            { id: 20, name: 'โครงชุดฝึก', qty: 2, price: 0, link: '' },
            { id: 21, name: 'ไม้อัด', qty: 1, price: 0, link: '' },
            { id: 22, name: 'ล้อ 5"', qty: 8, price: 0, link: '' },
            { id: 23, name: 'ยางรองแอร์', qty: 8, price: 0, link: '' },
            { id: 24, name: 'น้ำยาล้างแอร์', qty: 1, price: 0, link: '' },
            { id: 25, name: 'ป้ายห้าม', qty: 1, price: 0, link: '' },
        ];

        function App() {
            const [items, setItems] = useState(INITIAL_ITEMS);
            const [isLoaded, setIsLoaded] = useState(false);
            const [syncStatus, setSyncStatus] = useState('connecting'); 

            // เชื่อมต่อและดึงข้อมูลจาก Realtime Database (แบบง่าย)
            useEffect(() => {
                // รอให้ Firebase พร้อมทำงานนิดนึง
                const checkFirebase = setInterval(() => {
                    if (window.firebaseDb) {
                        clearInterval(checkFirebase);
                        const dbRef = window.firebaseRef(window.firebaseDb, 'budget_app_demo/items');
                        
                        window.firebaseOnValue(dbRef, (snapshot) => {
                            const data = snapshot.val();
                            if (data) {
                                setItems(data);
                            } else {
                                // ถ้าไม่มีข้อมูลบน Cloud ให้เอา INITIAL_ITEMS ขึ้นไปเป็นตั้งต้น
                                window.firebaseSet(dbRef, INITIAL_ITEMS);
                            }
                            setIsLoaded(true);
                            setSyncStatus('synced');
                        });
                    }
                }, 100);

                return () => clearInterval(checkFirebase);
            }, []);

            // ฟังก์ชันสำหรับบันทึกข้อมูลขึ้น Cloud
            const saveToCloud = useCallback((newItems) => {
                if (!window.firebaseDb) return;
                setSyncStatus('saving');
                const dbRef = window.firebaseRef(window.firebaseDb, 'budget_app_demo/items');
                window.firebaseSet(dbRef, newItems)
                    .then(() => setSyncStatus('synced'))
                    .catch(() => setSyncStatus('error'));
            }, []);

            const updateName = (id, newName) => {
                const newItems = items.map(item => item.id === id ? { ...item, name: newName } : item);
                setItems(newItems);
                saveToCloud(newItems);
            };

            const addItem = () => {
                const maxId = items.length > 0 ? Math.max(...items.map(i => i.id)) : 0;
                const newItem = { id: maxId + 1, name: '', qty: 1, price: 0, link: '' };
                const newItems = [...items, newItem];
                setItems(newItems);
                saveToCloud(newItems);
            };

            const deleteItem = (id) => {
                const newItems = items.filter(item => item.id !== id);
                setItems(newItems);
                saveToCloud(newItems);
            };

            const updateQuantity = (id, delta) => {
                const newItems = items.map(item => {
                    if (item.id === id) return { ...item, qty: Math.max(0, item.qty + delta) };
                    return item;
                });
                setItems(newItems);
                saveToCloud(newItems);
            };

            const updatePrice = (id, newPrice) => {
                const priceNum = parseFloat(newPrice) || 0;
                const newItems = items.map(item => item.id === id ? { ...item, price: priceNum } : item);
                setItems(newItems);
                saveToCloud(newItems);
            };

            const updateLink = (id, newLink) => {
                const newItems = items.map(item => item.id === id ? { ...item, link: newLink } : item);
                setItems(newItems);
                saveToCloud(newItems);
            };

            const totalSpent = useMemo(() => {
                return items.reduce((sum, item) => sum + (item.qty * item.price), 0);
            }, [items]);

            const remainingBudget = INITIAL_BUDGET - totalSpent;
            const isOverBudget = remainingBudget < 0;

            const formatMoney = (num) => new Intl.NumberFormat('th-TH', { style: 'currency', currency: 'THB', minimumFractionDigits: 2 }).format(num);
            const formatCompactMoney = (num) => new Intl.NumberFormat('th-TH', { style: 'currency', currency: 'THB', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num);

            if (!isLoaded) return <div className="p-10 text-center font-bold text-emerald-600">กำลังเชื่อมต่อฐานข้อมูล...</div>;

            return (
                <div className="pb-20">
                    <div className="pt-6 pb-2 px-4 sm:px-6 max-w-5xl mx-auto flex items-center gap-2">
                        <Sprout className="w-6 h-6 text-emerald-600 shrink-0" />
                        <h1 className="text-xl sm:text-2xl font-bold text-stone-800 leading-tight">โครงการ ชุดสาธิตการติดตั้งแอร์ (สารทำความเย็นธรรมชาติ)</h1>
                    </div>

                    <div className="sticky top-0 z-50 bg-[#F8F9F8]/95 backdrop-blur shadow-sm pb-4 pt-2">
                        <div className="max-w-5xl mx-auto px-2 sm:px-6">
                            <div className="grid grid-cols-3 gap-2 sm:gap-4">
                                <div className="bg-white p-3 sm:p-4 rounded-xl shadow-sm border border-stone-200">
                                    <div className="flex justify-between items-start mb-1 sm:mb-2">
                                        <p className="text-[10px] sm:text-sm text-stone-500 font-medium leading-none">งบประมาณที่ตั้งไว้</p>
                                        <Wallet className="w-3.5 h-3.5 sm:w-5 sm:h-5 text-stone-400 shrink-0 hidden sm:block" />
                                    </div>
                                    <p className="text-sm sm:text-xl font-bold text-stone-800 tracking-tight leading-none truncate">{formatMoney(INITIAL_BUDGET)}</p>
                                </div>
                                <div className="bg-[#FFF9E6] p-3 sm:p-4 rounded-xl shadow-sm border border-amber-200/60">
                                    <div className="flex justify-between items-start mb-1 sm:mb-2">
                                        <p className="text-[10px] sm:text-sm text-amber-700 font-medium leading-none">ยอดรวมประเมิน</p>
                                        <ShoppingCart className="w-3.5 h-3.5 sm:w-5 sm:h-5 text-amber-500 shrink-0 hidden sm:block" />
                                    </div>
                                    <p className="text-sm sm:text-xl font-bold text-amber-900 tracking-tight leading-none truncate">{formatMoney(totalSpent)}</p>
                                </div>
                                <div className={`p-3 sm:p-4 rounded-xl shadow-sm border transition-colors ${isOverBudget ? 'bg-red-50 border-red-200' : 'bg-[#E8F5E9] border-emerald-200/60'}`}>
                                    <div className="flex justify-between items-start mb-1 sm:mb-2">
                                        <p className={`text-[10px] sm:text-sm font-medium leading-none ${isOverBudget ? 'text-red-600' : 'text-emerald-700'}`}>{isOverBudget ? 'งบประมาณติดลบ' : 'งบประมาณคงเหลือ'}</p>
                                        {isOverBudget && <AlertCircle className="w-3.5 h-3.5 sm:w-5 sm:h-5 text-red-500 shrink-0 hidden sm:block" />}
                                    </div>
                                    <p className={`text-sm sm:text-xl font-bold tracking-tight leading-none truncate ${isOverBudget ? 'text-red-700' : 'text-emerald-800'}`}>{formatMoney(remainingBudget)}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div className="max-w-5xl mx-auto px-2 sm:px-6 mt-4">
                        <div className="flex justify-between items-end mb-3 px-2">
                            <h2 className="text-sm sm:text-lg font-bold text-stone-700">รายการวัสดุฝึกปฏิบัติ ({items.length} รายการ)</h2>
                            <span className="bg-stone-200/70 text-stone-600 px-2 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-medium flex items-center gap-1.5">
                                {syncStatus === 'connecting' && 'กำลังเชื่อมต่อ...'}
                                {syncStatus === 'saving' && 'กำลังบันทึก...'}
                                {syncStatus === 'synced' && <><CheckCircle2 className="w-3 h-3 text-emerald-600" /> อัพเดทแล้ว</>}
                                {syncStatus === 'error' && 'ข้อผิดพลาด'}
                            </span>
                        </div>

                        <div className="bg-white rounded-2xl shadow-sm border border-stone-200/70 overflow-hidden">
                            <div className="grid grid-cols-[1fr_65px_70px_60px_28px] sm:grid-cols-[1fr_100px_100px_100px_40px] gap-1 sm:gap-4 p-2 sm:p-4 bg-stone-50 border-b border-stone-200 text-[10px] sm:text-sm font-semibold text-stone-500 text-center items-center">
                                <div className="text-left pl-1">รายการสินค้า</div>
                                <div>ราคา/หน่วย</div>
                                <div>จำนวน</div>
                                <div className="text-right pr-2">รวมเงิน</div>
                                <div></div>
                            </div>

                            <div className="divide-y divide-stone-100">
                                {items.map((item) => (
                                    <div key={item.id} className="grid grid-cols-[1fr_65px_70px_60px_28px] sm:grid-cols-[1fr_100px_100px_100px_40px] gap-1 sm:gap-4 p-2 sm:p-4 items-center hover:bg-stone-50/50 transition-colors group">
                                        <div className="flex flex-col justify-center min-w-0 pr-1 sm:pr-2">
                                            <div className="flex items-center gap-1 mb-1">
                                                <span className="text-stone-400 font-normal text-[10px] sm:text-sm shrink-0">#{item.id}</span>
                                                <input type="text" value={item.name} onChange={(e) => updateName(item.id, e.target.value)} placeholder="ระบุชื่อรายการ..." className="w-full bg-transparent font-semibold text-xs sm:text-base text-stone-800 placeholder:text-stone-300 outline-none focus:border-b focus:border-emerald-300 truncate" title={item.name} />
                                            </div>
                                            <div className="flex items-center gap-1.5 border-b border-transparent focus-within:border-emerald-300 transition-colors">
                                                <LinkIcon className="w-3 h-3 sm:w-3.5 sm:h-3.5 text-stone-400 shrink-0" />
                                                <input type="url" value={item.link} onChange={(e) => updateLink(item.id, e.target.value)} placeholder="วางลิงก์ซื้อ..." className="w-full bg-transparent p-0 m-0 border-none focus:ring-0 text-[10px] sm:text-xs text-emerald-600 placeholder:text-stone-300 outline-none" />
                                                {item.link && (
                                                    <a href={item.link} target="_blank" rel="noopener noreferrer" className="text-emerald-500 hover:text-emerald-600 shrink-0"><ExternalLink className="w-3 h-3 sm:w-3.5 sm:h-3.5" /></a>
                                                )}
                                            </div>
                                        </div>

                                        <div><input type="number" min="0" value={item.price || ''} onChange={(e) => updatePrice(item.id, e.target.value)} placeholder="0" className="w-full text-right text-xs sm:text-sm px-1 sm:px-2 py-1.5 sm:py-2 bg-white border border-stone-200 rounded-md sm:rounded-lg focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all text-stone-800 font-medium shadow-sm" /></div>

                                        <div className="flex items-center justify-between bg-white border border-stone-200 rounded-md sm:rounded-lg p-0.5 sm:p-1 shadow-sm">
                                            <button onClick={() => updateQuantity(item.id, -1)} className="w-4 h-4 sm:w-7 sm:h-7 flex items-center justify-center rounded hover:bg-stone-100 text-stone-600 disabled:opacity-30 transition-colors" disabled={item.qty <= 0}><Minus className="w-3 h-3 sm:w-4 sm:h-4" /></button>
                                            <span className="text-xs sm:text-sm font-bold text-stone-800">{item.qty}</span>
                                            <button onClick={() => updateQuantity(item.id, 1)} className="w-4 h-4 sm:w-7 sm:h-7 flex items-center justify-center rounded hover:bg-stone-100 text-stone-600 transition-colors"><Plus className="w-3 h-3 sm:w-4 sm:h-4" /></button>
                                        </div>

                                        <div className="text-right pr-1 sm:pr-2"><span className="text-[10px] sm:text-base font-bold text-emerald-700 tracking-tight truncate block">{formatCompactMoney(item.qty * item.price)}</span></div>

                                        <div className="flex justify-center">
                                            <button onClick={() => deleteItem(item.id)} className="p-1 sm:p-2 text-stone-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors opacity-100 sm:opacity-0 sm:group-hover:opacity-100" title="ลบรายการนี้"><Trash2 className="w-3.5 h-3.5 sm:w-5 sm:h-5" /></button>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            <div className="p-3 sm:p-4 bg-stone-50/50 border-t border-stone-200 flex justify-center">
                                <button onClick={addItem} className="flex items-center gap-2 text-xs sm:text-sm text-emerald-600 font-semibold hover:text-emerald-700 bg-emerald-100/50 hover:bg-emerald-100 px-4 py-2 rounded-lg transition-colors"><PlusCircle className="w-4 h-4 sm:w-5 sm:h-5" /> เพิ่มรายการใหม่</button>
                            </div>
                        </div>

                        <div className="mt-8 text-center text-stone-400 text-xs sm:text-sm pb-10"><p>ออกแบบสำหรับ โครงการชุดสาธิตการติดตั้งเครื่องปรับอากาศ</p></div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
